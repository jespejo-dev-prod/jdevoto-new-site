# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
/src/generated/

# Local logs and debug files
/logs
*.log

# File uploads and local storage
/storage
/public/uploads

# IDE configurations
.idea/
.vscode/

# Excel sheets, data files, compressions and SQL dumps
*.xlsx
*.csv
*.sql
# Exception: Prisma migrations must be tracked in git for migrate deploy to work
!prisma/migrations/**/*.sql
*.zip
*.rar
/excel_users

# Scripts
/scripts
/src/scripts

# Gemini progress
gemini-progress.json
test/
/docs
