generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String             @id @default(cuid())
  rut                 String             @unique
  razonSocial         String
  nombreFantasia      String?
  giro                String?
  direccion           String?
  comuna              String?
  ciudad              String?
  region              String?
  pais                String             @default("CL")
  telefono            String?
  email               String?
  website             String?
  creditLimit         Decimal            @default(0) @db.Decimal(15, 2)
  creditUsed          Decimal            @default(0) @db.Decimal(15, 2)
  paymentTerms        Int                @default(30)
  defaultDiscount     Decimal            @default(0) @db.Decimal(5, 2)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  billingApartment    String?
  billingCity         String?
  billingCommune      String?
  billingEmail        String?
  billingNumber       String?
  billingRegion       String?
  billingStreet       String?
  shippingApartment   String?
  shippingCity        String?
  shippingCommune     String?
  shippingNumber      String?
  shippingRegion      String?
  shippingStreet      String?
  paymentTermDiscount Decimal            @default(0) @db.Decimal(5, 2)
  salesRepId          String?
  salesRep            User?              @relation("CompanySalesRep", fields: [salesRepId], references: [id])
  priceLists          CompanyPriceList[]
  orders              Order[]
  users               User[]

  @@index([rut])
  @@index([isActive])
  @@index([salesRepId])
  @@map("companies")
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  role              UserRole       @default(BUYER)
  isActive          Boolean        @default(true)
  twoFactorSecret   String?
  companyId         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  auditLogs         AuditLog[]
  assignedCompanies Company[]      @relation("CompanySalesRep")
  notifications     Notification[]
  sentMessages      OrderMessage[] @relation("OrderMessagesSent")
  orders            Order[]        @relation("CreatedByUser")
  attributedOrders  Order[]        @relation("OrderSalesRep")
  refreshTokens     RefreshToken[]
  company           Company        @relation(fields: [companyId], references: [id])

  @@index([email])
  @@index([companyId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  parentId    String?
  isOutlet    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryTree")
  products    Product[]
  promotions  Promotion[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  slug           String          @unique
  description    String?
  brandId        String?
  unit           String          @default("UN")
  inner          Int             @default(1)
  basePrice      Decimal         @db.Decimal(15, 2)
  stockQuantity  BigInt          @default(0)
  minOrderQty    Int             @default(1)
  stockAlert     Int             @default(5)
  isActive       Boolean         @default(true)
  categoryId     String?
  seoTitle       String?
  seoDescription String?
  specifications Json?           @default("[]")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  height         Decimal?        @db.Decimal(15, 2)
  length         Decimal?        @db.Decimal(15, 2)
  weight         Decimal?        @db.Decimal(15, 2)
  width          Decimal?        @db.Decimal(15, 2)
  isDeleted      Boolean         @default(false)
  orderItems     OrderItem[]
  priceListItems PriceListItem[]
  images         ProductImage[]
  brand          Brand?          @relation(fields: [brandId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])

  @@index([sku])
  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([brandId])
  @@index([isActive, categoryId])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([isActive, name])
  @@index([isActive, isDeleted])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  position  Int      @default(0)
  altText   String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model PriceList {
  id             String             @id @default(cuid())
  name           String
  description    String?
  type           PriceListType      @default(GENERAL)
  globalDiscount Decimal            @default(0) @db.Decimal(5, 2)
  isActive       Boolean            @default(true)
  validFrom      DateTime?
  validTo        DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  companies      CompanyPriceList[]
  items          PriceListItem[]

  @@index([type])
  @@index([isActive])
  @@map("price_lists")
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  productId   String
  netPrice    Decimal   @db.Decimal(15, 2)
  discount    Decimal   @default(0) @db.Decimal(5, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([productId])
  @@map("price_list_items")
}

model CompanyPriceList {
  id          String    @id @default(cuid())
  companyId   String
  priceListId String
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([companyId, priceListId])
  @@index([companyId])
  @@map("company_price_lists")
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  companyId       String
  createdById     String
  status          OrderStatus    @default(DRAFT)
  paymentStatus   PaymentStatus  @default(PENDING)
  subtotalNet     Decimal        @db.Decimal(15, 2)
  taxAmount       Decimal        @db.Decimal(15, 2)
  totalGross      Decimal        @db.Decimal(15, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(15, 2)
  shippingAddress Json?
  notes           String?
  internalNotes   String?
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  billingAddress  Json?
  paymentMethod   String?
  salesRepId      String?
  items           OrderItem[]
  messages        OrderMessage[]
  company         Company        @relation(fields: [companyId], references: [id])
  createdBy       User           @relation("CreatedByUser", fields: [createdById], references: [id])
  salesRep        User?          @relation("OrderSalesRep", fields: [salesRepId], references: [id])

  @@index([orderNumber])
  @@index([companyId])
  @@index([status])
  @@index([createdById])
  @@index([salesRepId])
  @@index([createdAt])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  productSku   String
  productName  String
  quantity     Int
  unitNetPrice Decimal  @db.Decimal(15, 2)
  discount     Decimal  @default(0) @db.Decimal(5, 2)
  lineNetTotal Decimal  @db.Decimal(15, 2)
  lineTax      Decimal  @db.Decimal(15, 2)
  lineTotal    Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Brand {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  imageUrl    String?
  products    Product[]
  promotions  Promotion[]

  @@map("brands")
}

model Promotion {
  id         String    @id @default(cuid())
  name       String
  discount   Decimal   @db.Decimal(5, 2)
  brandId    String?
  categoryId String?
  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validTo    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  brand      Brand?    @relation(fields: [brandId], references: [id])
  category   Category? @relation(fields: [categoryId], references: [id])

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@map("promotions")
}

model StoreSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

model OrderMessage {
  id                String   @id @default(cuid())
  orderId           String
  senderId          String
  message           String?
  attachmentUrl     String?
  attachmentName    String?
  isCustomerVisible Boolean  @default(true)
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender            User     @relation("OrderMessagesSent", fields: [senderId], references: [id])

  @@index([orderId])
  @@map("order_messages")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemErrorLog {
  id        String   @id @default(cuid())
  path      String
  method    String
  errorName String
  message   String
  stack     String?
  userId    String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("system_error_logs")
}

enum UserRole {
  ADMIN
  SALES_REP
  BUYER
  COMPANY_ADMIN
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  CANCELLED
  REJECTED
  PENDING
  DELIVERED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  REFUNDED
}

enum PriceListType {
  GENERAL
  COMPANY
}
